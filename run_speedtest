#!/usr/bin/env bash

# Check network speed using speedtest-cli or official speedtest

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}Starting Network Speed Test...${NC}"

# Determine which speedtest command is available
CMD=""
if command -v speedtest-cli &>/dev/null; then
    # The --simple flag makes the python version's output much cleaner
    CMD="speedtest-cli --simple"
elif command -v speedtest &>/dev/null; then
    # The official Ookla version
    CMD="speedtest"
else
    echo -e "${RED}Error: No speedtest tool found.${NC}"
    echo "Please install speedtest-cli using one of the following methods:"
    echo "  Ubuntu/Debian: sudo apt install speedtest-cli"z
    echo "  Fedora: sudo dnf install speedtest-cli"
    echo "  macOS: brew install speedtest-cli"
    echo "  Python (pip): pip install speedtest-cli"
    exit 1
fi

echo -e "${YELLOW}Running speed test. This may take a minute...${NC}"
echo "------------------------------------------------"

$CMD

echo "------------------------------------------------"
echo -e "${GREEN}Test Complete!${NC}"

